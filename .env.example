DATABASE_URL=postgresql+psycopg://agent_user:agent_pass@postgres:5432/agent_service
REDIS_URL=redis://redis:6379/0
APP_ENV=local
DEFAULT_MODEL=llama-3.3-70b-versatile
GROQ_API_KEY=your_groq_api_key_here
# Set USE_MOCK_LLM=true only for offline runs without a Groq key
USE_MOCK_LLM=false

RATE_LIMIT_MAX=10
TENANT_DAILY_BUDGET_USD=1.0
SESSION_BUDGET_USD=0.05
